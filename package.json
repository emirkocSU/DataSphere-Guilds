{
  "name": "@datasphere/workspace",
  "version": "2.0.0",
  "private": true,
  "description": "DataSphere Guilds — Enterprise-grade crowdsourcing platform for real-world data collection with advanced quality control and AI validation",
  "scripts": {
    "build": "nx run-many --target=build",
    "build:packages": "nx run-many --target=build --projects=tag:package",
    "build:services": "nx run-many --target=build --projects=tag:service",
    "build:apps": "nx run-many --target=build --projects=tag:app",
    "build:affected": "nx affected --target=build",
    "dev": "nx run-many --target=dev --parallel",
    "start": "pnpm dev",
    "clean": "nx run-many --target=clean && rimraf node_modules .turbo dist build coverage .nyc_output",
    "lint": "nx run-many --target=lint",
    "lint:fix": "nx run-many --target=lint --fix",
    "type-check": "nx run-many --target=type-check",
    "test": "nx run-many --target=test",
    "test:coverage": "nx run-many --target=test --coverage",
    "test:affected": "nx affected --target=test",
    "test:watch": "nx run-many --target=test --watch",
    "graph": "nx graph",
    "format": "prettier --write \"**/*.{ts,tsx,js,jsx,json,md,yaml,yml}\"",
    "format:check": "prettier --check \"**/*.{ts,tsx,js,jsx,json,md,yaml,yml}\"",
    "security:audit": "pnpm audit --audit-level=moderate",
    "prepare": "pnpm build:packages"
  },
  "dependencies": {
    "@elastic/elasticsearch": "^8.12.2",
    "csso": "^5.0.5",
    "dotenv": "^17.2.0",
    "lodash": "^4.17.21",
    "redis": "^4.6.13",
    "sharp": "^0.35.4",
    "terser": "^5.28.1",
    "tslib": "^2.6.2",
    "uuid": "^9.0.1",
    "zod": "^3.22.4"
  },
  "devDependencies": {
    "@changesets/changelog-github": "^0.5.0",
    "@changesets/cli": "^2.27.1",
    "@commitlint/cli": "^18.6.0",
    "@commitlint/config-conventional": "^18.6.0",
    "@datasphere/eslint-config": "workspace:*",
    "@datasphere/prettier-config": "workspace:*",
    "@datasphere/tsconfig": "workspace:*",
    "@jest/globals": "^29.7.0",
    "@nx/devkit": "^18.0.4",
    "@nx/eslint": "^18.0.4",
    "@nx/jest": "^18.0.4",
    "@nx/js": "^18.0.4",
    "@nx/node": "^18.0.4",
    "@nx/react": "^18.0.4",
    "@nx/workspace": "^18.0.4",
    "@turbo/gen": "^1.12.4",
    "@types/jest": "^29.5.12",
    "@types/lodash": "^4.17.20",
    "@types/node": "^20.11.16",
    "@types/uuid": "^9.0.8",
    "@typescript-eslint/eslint-plugin": "^7.0.0",
    "@typescript-eslint/parser": "^7.0.0",
    "concurrently": "^8.2.2",
    "cross-env": "^7.0.3",
    "eslint": "^8.56.0",
    "eslint-plugin-react": "^7.33.2",
    "husky": "^9.0.10",
    "lerna": "^8.0.2",
    "license-checker": "^25.0.1",
    "lint-staged": "^15.2.2",
    "nx": "21.2.4",
    "patch-package": "^8.0.0",
    "prettier": "^3.2.5",
    "rimraf": "^5.0.5",
    "turbo": "^1.12.4",
    "typescript": "^5.3.3"
  },
  "packageManager": "pnpm@8.15.4"
}