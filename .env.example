# =============================================================================
# DATASPHERE GUILDS - ENVIRONMENT CONFIGURATION
# =============================================================================
# Enterprise-grade environment variables for global data marketplace platform
# Version: 2.0.0 | Last Updated: 2024-01-XX
# Security Level: SOC 2 Type II Compliant
# =============================================================================

# =============================================================================
# 🌍 ENVIRONMENT CONFIGURATION
# =============================================================================
NODE_ENV=development
APP_ENV=development
APP_VERSION=2.0.0
APP_BUILD_NUMBER=1
PLATFORM=mobile
DEBUG_MODE=true
VERBOSE_LOGGING=false

# =============================================================================
# 🏗️ APPLICATION CORE SETTINGS
# =============================================================================
APP_NAME="DataSphere Guilds"
APP_SCHEME=datasphereguilds
APP_SLUG=datasphere-guilds
APP_BUNDLE_ID=com.datasphereguilds.app
APP_PACKAGE_NAME=com.datasphereguilds.app
APP_DEEP_LINK_DOMAIN=datasphereguilds.com
APP_UNIVERSAL_LINK_DOMAIN=link.datasphereguilds.com

# =============================================================================
# 🌐 API & BACKEND CONFIGURATION
# =============================================================================
# Primary API Endpoints
API_BASE_URL=https://api-dev.datasphereguilds.com
API_VERSION=v2
API_TIMEOUT=30000
API_RETRY_ATTEMPTS=3
API_RETRY_DELAY=1000

# GraphQL Configuration
GRAPHQL_ENDPOINT=https://graphql-dev.datasphereguilds.com/graphql
GRAPHQL_WEBSOCKET_ENDPOINT=wss://graphql-dev.datasphereguilds.com/graphql
GRAPHQL_PLAYGROUND_ENABLED=true
GRAPHQL_INTROSPECTION_ENABLED=true

# REST API Configuration
REST_API_ENDPOINT=https://rest-dev.datasphereguilds.com/api
REST_API_RATE_LIMIT=1000
REST_API_BURST_LIMIT=100

# =============================================================================
# 🔐 AUTHENTICATION & AUTHORIZATION
# =============================================================================
# JWT Configuration
JWT_SECRET=-super-secret-jwt-key-min-256-chars
JWT_EXPIRATION=24h
JWT_REFRESH_EXPIRATION=30d
JWT_ALGORITHM=HS256
JWT_ISSUER=datasphereguilds.com
JWT_AUDIENCE=datasphere-mobile

# OAuth 2.0 / OpenID Connect
OAUTH_CLIENT_ID=-oauth-client-id
OAUTH_CLIENT_SECRET=-oauth-client-secret
OAUTH_REDIRECT_URI=https://auth.datasphereguilds.com/callback
OAUTH_SCOPE=openid profile email phone

# Auth0 Configuration
AUTH0_DOMAIN=datasphereguilds.auth0.com
AUTH0_CLIENT_ID=-auth0-client-id
AUTH0_CLIENT_SECRET=-auth0-client-secret
AUTH0_AUDIENCE=https://api.datasphereguilds.com

# Firebase Auth (Alternative)
FIREBASE_PROJECT_ID=datasphere-guilds-prod
FIREBASE_APP_ID=-firebase-app-id
FIREBASE_API_KEY=-firebase-api-key
FIREBASE_AUTH_DOMAIN=datasphere-guilds-prod.firebaseapp.com
FIREBASE_STORAGE_BUCKET=datasphere-guilds-prod.appspot.com
FIREBASE_MESSAGING_SENDER_ID=-sender-id

# =============================================================================
# 💾 DATABASE CONFIGURATION
# =============================================================================
# Primary Database (PostgreSQL)
DATABASE_URL=postgresql://username:password@localhost:5432/datasphere_guilds_dev
DATABASE_HOST=localhost
DATABASE_PORT=5432
DATABASE_NAME=datasphere_guilds_dev
DATABASE_USERNAME=postgres
DATABASE_PASSWORD=-database-password
DATABASE_SSL=false
DATABASE_POOL_SIZE=20
DATABASE_CONNECTION_TIMEOUT=30000
DATABASE_QUERY_TIMEOUT=60000

# Redis Configuration
REDIS_URL=redis://localhost:6379
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=-redis-password
REDIS_DB=0
REDIS_TTL=3600
REDIS_MAX_CONNECTIONS=100

# MongoDB (for Analytics/Logging)
MONGODB_URL=mongodb://localhost:27017/datasphere_analytics
MONGODB_HOST=localhost
MONGODB_PORT=27017
MONGODB_DATABASE=datasphere_analytics
MONGODB_USERNAME=mongo_user
MONGODB_PASSWORD=-mongo-password

# =============================================================================
# 🎯 AI & MACHINE LEARNING
# =============================================================================
# OpenAI Configuration
OPENAI_API_KEY=sk--openai-api-key
OPENAI_ORGANIZATION=-openai-org-id
OPENAI_MODEL=gpt-4
OPENAI_MAX_TOKENS=2000
OPENAI_TEMPERATURE=0.7

# Anthropic Claude
ANTHROPIC_API_KEY=-anthropic-api-key
ANTHROPIC_MODEL=claude-3-opus-20240229
ANTHROPIC_MAX_TOKENS=4000

# Google AI/ML Services
GOOGLE_AI_API_KEY=yur-google-ai-api-key
GOOGLE_CLOUD_PROJECT_ID=datasphere-guilds-ml
GOOGLE_CLOUD_REGION=us-central1
GOOGLE_CLOUD_BUCKET=datasphere-ml-models

# AWS AI Services
AWS_ACCESS_KEY_ID=yur-aws-access-key
AWS_SECRET_ACCESS_KEY=-aws-secret-key
AWS_REGION=us-west-2
AWS_S3_BUCKET=datasphere-ai-models
AWS_BEDROCK_MODEL_ID=anthropic.claude-3-sonnet-20240229-v1:0

# =============================================================================
# 📊 QUALITY CONTROL & ANALYTICS
# =============================================================================
# QC Pipeline Configuration
QC_PIPELINE_ENABLED=true
QC_CONFIDENCE_THRESHOLD=0.85
QC_MANUAL_REVIEW_THRESHOLD=0.70
QC_AUTO_APPROVE_THRESHOLD=0.95
QC_BATCH_SIZE=100
QC_PROCESSING_TIMEOUT=300000

# Analytics & Tracking
ANALYTICS_ENABLED=true
ANALYTICS_PROVIDER=mixpanel
ANALYTICS_API_KEY=-analytics-api-key
ANALYTICS_DEBUG=false
ANALYTICS_BATCH_SIZE=50
ANALYTICS_FLUSH_INTERVAL=30000

# A/B Testing
AB_TESTING_ENABLED=true
AB_TESTING_PROVIDER=optimizely
AB_TESTING_SDK_KEY=-ab-testing-sdk-key

# =============================================================================
# 💰 PAYMENT & BILLING
# =============================================================================
# Stripe Configuration
STRIPE_PUBLISHABLE_KEY=sk-stripe-publishable-key
STRIPE_SECRET_KEY=sk_test-stripe-secret-key
STRIPE_WEBHOOK_SECRET=whsec-stripe-webhook-secret
STRIPE_ACCOUNT_ID=acct-stripe-account-id

# PayPal Configuration
PAYPAL_CLIENT_ID=y-paypal-client-id
PAYPAL_CLIENT_SECRET=-paypal-client-secret
PAYPAL_ENVIRONMENT=sandbox
PAYPAL_WEBHOOK_ID=-paypal-webhook-id

# Apple Pay Configuration
APPLE_PAY_MERCHANT_ID=merchant.com.datasphereguilds.app
APPLE_PAY_CERTIFICATE_PATH=./certs/apple-pay-cert.p12
APPLE_PAY_CERTIFICATE_PASSWORD=-apple-pay-cert-password

# Google Pay Configuration
GOOGLE_PAY_MERCHANT_ID=-google-pay-merchant-id
GOOGLE_PAY_MERCHANT_NAME=DataSphere Guilds
GOOGLE_PAY_ENVIRONMENT=TEST

# =============================================================================
# 📱 MOBILE PUSH NOTIFICATIONS
# =============================================================================
# Firebase Cloud Messaging
FCM_SERVER_KEY=-fcm-server-key
FCM_SENDER_ID=-fcm-sender-id

# Apple Push Notification Service
APNS_KEY_ID=-apns-key-id
APNS_TEAM_ID=-apns-team-id
APNS_BUNDLE_ID=com.datasphereguilds.app
APNS_CERTIFICATE_PATH=./certs/apns-cert.p8
APNS_ENVIRONMENT=development

# OneSignal (Alternative)
ONESIGNAL_APP_ID=-onesignal-app-id
ONESIGNAL_API_KEY=-onesignal-api-key

# =============================================================================
# 🔗 THIRD-PARTY INTEGRATIONS
# =============================================================================
# Social Media APIs
TWITTER_API_KEY=-twitter-api-key
TWITTER_API_SECRET=-twitter-api-secret
TWITTER_BEARER_TOKEN=y-twitter-bearer-token

FACEBOOK_APP_ID=facebook-app-id
FACEBOOK_APP_SECRET=facebook-app-secret

LINKEDIN_CLIENT_ID=linkedin-client-id
LINKEDIN_CLIENT_SECRET=-linkedin-client-secret

# Google Services
GOOGLE_MAPS_API_KEY=-google-maps-api-key
GOOGLE_PLACES_API_KEY=-google-places-api-key
GOOGLE_GEOCODING_API_KEY=-google-geocoding-api-key

# Weather API
WEATHER_API_KEY=-weather-api-key
WEATHER_API_PROVIDER=openweathermap

# SMS/Communication
TWILIO_ACCOUNT_SID=-twilio-account-sid
TWILIO_AUTH_TOKEN=-twilio-auth-token
TWILIO_PHONE_NUMBER=+1234567890

SENDGRID_API_KEY=-sendgrid-api-key
SENDGRID_FROM_EMAIL=noreply@datasphereguilds.com

# =============================================================================
# 🌐 CDN & STORAGE
# =============================================================================
# AWS S3 Configuration
AWS_S3_ACCESS_KEY_ID=-s3-access-key
AWS_S3_SECRET_ACCESS_KEY=-s3-secret-key
AWS_S3_REGION=us-west-2
AWS_S3_BUCKET=datasphere-assets
AWS_S3_BUCKET_IMAGES=datasphere-images
AWS_S3_BUCKET_DOCUMENTS=datasphere-documents
AWS_S3_BUCKET_VIDEOS=datasphere-videos
AWS_S3_CLOUDFRONT_DOMAIN=cdn.datasphereguilds.com

# Azure Storage (Alternative)
AZURE_STORAGE_ACCOUNT=dataspherestorage
AZURE_STORAGE_ACCESS_KEY=-azure-storage-key
AZURE_STORAGE_CONTAINER=datasphere-assets

# Google Cloud Storage (Alternative)
GCS_PROJECT_ID=datasphere-guilds-storage
GCS_BUCKET=datasphere-gcs-bucket
GCS_KEYFILE_PATH=./certs/gcs-service-account.json

# =============================================================================
# 🔍 MONITORING & OBSERVABILITY
# =============================================================================
# Sentry (Error Tracking)
SENTRY_DSN=https://-sentry-dsn@sentry.io/project-id
SENTRY_ENVIRONMENT=development
SENTRY_RELEASE=2.0.0
SENTRY_TRACES_SAMPLE_RATE=0.1

# DataDog (Monitoring)
DATADOG_API_KEY=-datadog-api-key
DATADOG_APP_KEY=-datadog-app-key
DATADOG_SITE=datadoghq.com

# New Relic (Alternative)
NEW_RELIC_LICENSE_KEY=-newrelic-license-key
NEW_RELIC_APP_NAME=DataSphere Guilds Mobile

# Grafana/Prometheus
GRAFANA_URL=https://grafana.datasphereguilds.com
PROMETHEUS_URL=https://prometheus.datasphereguilds.com

# =============================================================================
# 📊 SENSOR & IoT CONFIGURATION
# =============================================================================
# Sensor Collection Settings
SENSOR_COLLECTION_ENABLED=true
SENSOR_SAMPLING_RATE=100
SENSOR_BATCH_SIZE=1000
SENSOR_COMPRESSION_ENABLED=true
SENSOR_ENCRYPTION_ENABLED=true

# IoT Device Integration
IOT_MQTT_BROKER=mqtt://iot.datasphereguilds.com:1883
IOT_MQTT_USERNAME=iot_user
IOT_MQTT_PASSWORD=-iot-password
IOT_MQTT_CLIENT_ID=datasphere-mobile-client

# Vehicle OBD Integration
OBD_BLUETOOTH_ENABLED=true
OBD_WIFI_ENABLED=true
OBD_DIAGNOSTIC_LEVEL=2

# =============================================================================
# 🔒 SECURITY & COMPLIANCE
# =============================================================================
# Security Headers
SECURITY_HEADERS_ENABLED=true
SECURITY_CSP_ENABLED=true
SECURITY_HSTS_ENABLED=true
SECURITY_FRAME_OPTIONS=DENY

# Encryption
ENCRYPTION_ALGORITHM=AES-256-GCM
ENCRYPTION_KEY=-32-byte-encryption-key
ENCRYPTION_IV_LENGTH=16

# Privacy & Compliance
GDPR_COMPLIANCE_ENABLED=true
CCPA_COMPLIANCE_ENABLED=true
HIPAA_COMPLIANCE_ENABLED=true
DATA_RETENTION_DAYS=2555
ANONYMIZATION_ENABLED=true

# Rate Limiting
RATE_LIMIT_ENABLED=true
RATE_LIMIT_WINDOW=900000
RATE_LIMIT_MAX_REQUESTS=100
RATE_LIMIT_SKIP_FAILED_REQUESTS=true

# =============================================================================
# 🚀 PERFORMANCE & CACHING
# =============================================================================
# Cache Configuration
CACHE_ENABLED=true
CACHE_TTL=3600
CACHE_PREFIX=datasphere:
CACHE_COMPRESSION=true

# Performance Monitoring
PERFORMANCE_MONITORING_ENABLED=true
PERFORMANCE_SAMPLE_RATE=0.1
PERFORMANCE_TRACES_ENABLED=true

# CDN Configuration
CDN_ENABLED=true
CDN_DOMAIN=cdn.datasphereguilds.com
CDN_CACHE_CONTROL=public, max-age=31536000

# =============================================================================
# 🧪 TESTING & DEVELOPMENT
# =============================================================================
# Test Configuration
TEST_DATABASE_URL=postgresql://test_user:test_pass@localhost:5432/datasphere_test
TEST_REDIS_URL=redis://localhost:6379/1
TEST_TIMEOUT=30000
TEST_COVERAGE_THRESHOLD=80

# Development Tools
DEV_TOOLS_ENABLED=true
HOT_RELOAD_ENABLED=true
SOURCE_MAPS_ENABLED=true
PROFILING_ENABLED=false

# E2E Testing
E2E_BASE_URL=http://localhost:3000
E2E_TIMEOUT=30000
E2E_HEADLESS=true
E2E_BROWSER=chromium

# =============================================================================
# 📧 EMAIL & COMMUNICATION
# =============================================================================
# SMTP Configuration
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=true
SMTP_USERNAME=-email@gmail.com
SMTP_PASSWORD=-app-password

# Email Templates
EMAIL_TEMPLATES_ENABLED=true
EMAIL_TEMPLATE_ENGINE=handlebars
EMAIL_TEMPLATE_CACHE=true

# =============================================================================
# 🌍 INTERNATIONALIZATION
# =============================================================================
# i18n Configuration
I18N_ENABLED=true
I18N_DEFAULT_LOCALE=en
I18N_FALLBACK_LOCALE=en
I18N_SUPPORTED_LOCALES=en,es,fr,de,it,pt,ja,ko,zh,ar,hi,tr
I18N_NAMESPACE_SEPARATOR=:
I18N_KEY_SEPARATOR=.

# =============================================================================
# 🔌 WEBHOOK & REAL-TIME
# =============================================================================
# Webhook Configuration
WEBHOOK_ENABLED=true
WEBHOOK_SECRET=-webhook-secret
WEBHOOK_TIMEOUT=30000
WEBHOOK_RETRY_ATTEMPTS=3

# WebSocket Configuration
WEBSOCKET_ENABLED=true
WEBSOCKET_PORT=8080
WEBSOCKET_HEARTBEAT_INTERVAL=30000
WEBSOCKET_MAX_CONNECTIONS=10000

# =============================================================================
# 🤖 AUTOMATION & WORKFLOWS
# =============================================================================
# Workflow Engine
WORKFLOW_ENGINE_ENABLED=true
WORKFLOW_MAX_CONCURRENT_JOBS=100
WORKFLOW_JOB_TIMEOUT=3600000
WORKFLOW_RETRY_ATTEMPTS=3

# Cron Jobs
CRON_JOBS_ENABLED=true
CRON_TIMEZONE=UTC
CRON_MAX_CONCURRENT_JOBS=10

# =============================================================================
# 📈 BUSINESS INTELLIGENCE
# =============================================================================
# BI Configuration
BI_DASHBOARD_ENABLED=true
BI_REAL_TIME_ANALYTICS=true
BI_DATA_WAREHOUSE_URL=https://warehouse.datasphereguilds.com
BI_EXPORT_FORMATS=csv,json,xlsx,pdf

# =============================================================================
# 🌟 FEATURE FLAGS
# =============================================================================
# Feature Toggle Configuration
FEATURE_FLAGS_ENABLED=true
FEATURE_FLAGS_PROVIDER=launchdarkly
FEATURE_FLAGS_SDK_KEY=-feature-flags-sdk-key

# Beta Features
BETA_FEATURES_ENABLED=true
BETA_USER_PERCENTAGE=10
BETA_ROLLOUT_STRATEGY=percentage

# =============================================================================
# 🔄 BACKUP & DISASTER RECOVERY
# =============================================================================
# Backup Configuration
BACKUP_ENABLED=true
BACKUP_SCHEDULE=0 2 * * *
BACKUP_RETENTION_DAYS=30
BACKUP_ENCRYPTION_ENABLED=true
BACKUP_STORAGE_PROVIDER=aws-s3
BACKUP_S3_BUCKET=datasphere-backups

# Disaster Recovery
DR_ENABLED=true
DR_FAILOVER_REGION=us-east-1
DR_RECOVERY_TIME_OBJECTIVE=4
DR_RECOVERY_POINT_OBJECTIVE=1

# =============================================================================
# 🎨 BRANDING & CUSTOMIZATION
# =============================================================================
# Brand Configuration
BRAND_PRIMARY_COLOR=#1a73e8
BRAND_SECONDARY_COLOR=#34a853
BRAND_ACCENT_COLOR=#ea4335
BRAND_LOGO_URL=https://cdn.datasphereguilds.com/logo.png
BRAND_FAVICON_URL=https://cdn.datasphereguilds.com/favicon.ico

# Theme Configuration
THEME_DARK_MODE_ENABLED=true
THEME_SYSTEM_THEME_ENABLED=true
THEME_HIGH_CONTRAST_ENABLED=true
THEME_CUSTOM_CSS_ENABLED=true

# =============================================================================
# 🔧 SYSTEM MAINTENANCE
# =============================================================================
# Maintenance Mode
MAINTENANCE_MODE_ENABLED=false
MAINTENANCE_MESSAGE="System maintenance in progress. Please check back later."
MAINTENANCE_ALLOWED_IPS=127.0.0.1,::1

# Health Checks
HEALTH_CHECK_ENABLED=true
HEALTH_CHECK_INTERVAL=30000
HEALTH_CHECK_TIMEOUT=5000
HEALTH_CHECK_ENDPOINT=/health

# =============================================================================
# 📊 METRICS & KPIs
# =============================================================================
# Business Metrics
METRICS_ENABLED=true
METRICS_COLLECTION_INTERVAL=60000
METRICS_RETENTION_DAYS=365
METRICS_AGGREGATION_ENABLED=true

# Custom KPIs
KPI_DASHBOARD_ENABLED=true
KPI_REAL_TIME_UPDATES=true
KPI_ALERT_THRESHOLDS_ENABLED=true

# =============================================================================
# 🎯 PERSONALIZATION & RECOMMENDATIONS
# =============================================================================
# Recommendation Engine
RECOMMENDATIONS_ENABLED=true
RECOMMENDATIONS_ALGORITHM=collaborative-filtering
RECOMMENDATIONS_MIN_INTERACTIONS=5
RECOMMENDATIONS_CACHE_TTL=3600

# Personalization
PERSONALIZATION_ENABLED=true
PERSONALIZATION_PROFILE_SEGMENTS=10
PERSONALIZATION_CONTENT_FILTERING=true

# =============================================================================
# 🌐 GLOBAL CONFIGURATION
# =============================================================================
# Timezone & Locale
DEFAULT_TIMEZONE=UTC
DEFAULT_CURRENCY=USD
DEFAULT_LANGUAGE=en
DEFAULT_COUNTRY=US

# Regional Settings
REGIONAL_COMPLIANCE_ENABLED=true
REGIONAL_PAYMENT_METHODS_ENABLED=true
REGIONAL_LOCALIZATION_ENABLED=true

# =============================================================================
# 🔐 SECRETS MANAGEMENT
# =============================================================================
# Note: In production, use proper secret management services
# AWS Secrets Manager, Azure Key Vault, Google Secret Manager, etc.
SECRETS_MANAGER_ENABLED=false
SECRETS_MANAGER_PROVIDER=aws-secrets-manager
SECRETS_MANAGER_REGION=us-west-2

# =============================================================================
# 📝 LOGGING & AUDITING
# =============================================================================
# Logging Configuration
LOG_LEVEL=info
LOG_FORMAT=json
LOG_MAX_SIZE=100MB
LOG_MAX_FILES=10
LOG_ROTATION_ENABLED=true

# Audit Logging
AUDIT_LOG_ENABLED=true
AUDIT_LOG_EVENTS=create,update,delete,login,logout
AUDIT_LOG_RETENTION_DAYS=2555

# =============================================================================
# 🚀 DEPLOYMENT & CI/CD
# =============================================================================
# Deployment Configuration
DEPLOYMENT_ENVIRONMENT=development
DEPLOYMENT_BRANCH=develop
DEPLOYMENT_COMMIT_SHA=latest
DEPLOYMENT_TIMESTAMP=2024-01-01T00:00:00Z

# CI/CD Pipeline
CI_CD_ENABLED=true
CI_CD_PROVIDER=github-actions
CI_CD_WEBHOOK_SECRET=-ci-cd-webhook-secret

# =============================================================================
# 🎪 EXPERIMENTAL FEATURES
# =============================================================================
# Experimental Features (Use with caution)
EXPERIMENTAL_FEATURES_ENABLED=false
EXPERIMENTAL_AI_FEATURES=false
EXPERIMENTAL_BLOCKCHAIN_INTEGRATION=false
EXPERIMENTAL_AR_VR_SUPPORT=false

# =============================================================================
# 📚 DOCUMENTATION
# =============================================================================
# Documentation Links
DOCS_BASE_URL=https://docs.datasphereguilds.com
API_DOCS_URL=https://api-docs.datasphereguilds.com
SUPPORT_URL=https://support.datasphereguilds.com
COMMUNITY_URL=https://community.datasphereguilds.com

