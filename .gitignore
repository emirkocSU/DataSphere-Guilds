# =====================================================
# DataSphere Guilds - Professional .gitignore
# =====================================================
# This file is optimized for Expo/React Native projects
# with TypeScript, Redux, and cross-platform support
# =====================================================

# -----------------------------------------------------
# Node.js & Package Managers
# -----------------------------------------------------
node_modules/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*
.pnpm-store/
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/sdks
!.yarn/versions

# -----------------------------------------------------
# Expo
# -----------------------------------------------------
.expo/
.expo-shared/
dist/
*.expo-workflow
web-build/

# -----------------------------------------------------
# React Native
# -----------------------------------------------------
# Metro
.metro-health-check*
metro-cache/
.bundle/

# React Native CLI
*.hprof
.cxx/

# -----------------------------------------------------
